{
  "name": "paketa-teste-tecnico",
  "version": "1.0.0",
  "description": "API de gestão de menus com aninhamento infinito",
  "scripts": {
    "up": "docker compose --profile observability up -d --build --wait",
    "down": "docker compose --profile observability --profile load down --remove-orphans",
    "dev": "tsx watch src/main/server.ts",
    "dev:docker": "docker compose up -d --wait mongo && npm run dev",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "docker:up": "docker compose up -d --build --wait",
    "docker:logs": "docker compose logs -f api",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:architecture": "jest src/architecture.spec.ts",
    "load:smoke": "docker compose run --rm k6 run -e TEST_TYPE=smoke /scripts/menu.test.js",
    "load:load": "docker compose run --rm k6 run -e TEST_TYPE=load /scripts/menu.test.js",
    "load:stress": "docker compose run --rm k6 run -e TEST_TYPE=stress /scripts/menu.test.js",
    "load:spike": "docker compose run --rm k6 run -e TEST_TYPE=spike /scripts/menu.test.js",
    "load:burst": "docker compose run --rm k6 run -e TEST_TYPE=burst /scripts/menu.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gftf2011/paketa-teste-tecnico.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/gftf2011/paketa-teste-tecnico/issues"
  },
  "homepage": "https://github.com/gftf2011/paketa-teste-tecnico#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-express": "^0.72.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-mongodb": "^0.77.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.37.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "mongodb": "^6.22.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/supertest": "^6.0.3",
    "archunit": "^2.5.4",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
